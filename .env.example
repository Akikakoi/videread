# --- ASR（可选 dashscope / dashscope-realtime / openai）---
ASR_BACKEND=dashscope
# 字幕优先：视频带平台字幕时直接用字幕建转写稿，跳过音频下载与 ASR（0 关闭）
# 关闭后一律下载音频走 ASR；单次可用 CLI 的 --force-asr 临时覆盖
SUBTITLE_FIRST=1
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
DASHSCOPE_MODEL=paraformer-v2
# 提交给 ASR 的语言提示（zh / en 等）；设为 auto 时交给服务端自动识别
DASHSCOPE_LANGUAGE=zh

# --- 备用 ASR（可选）：把 ASR_BACKEND 改为 openai 时生效 ---
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_ASR_MODEL=whisper-1

# --- LLM ---
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL_PLAN=deepseek-chat
LLM_MODEL_WRITE=deepseek-chat
# 逐节写作并发路数（各节互相独立，加大可缩短总耗时，注意接口限流）
LLM_WRITE_CONCURRENCY=3
LLM_TIMEOUT=180

# --- 外部程序（可选，留空则自动探测）---
FFMPEG_BIN=
FFPROBE_BIN=

# --- 网络 ---
HTTP_PROXY=
HTTPS_PROXY=